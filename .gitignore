# secrets: never commit
.env
.env.*

# big or machine-specific
.venv/
models/
tools/
logs/
__pycache__/

# your data: videos, downloads, analysis results, logs
inbox/
out/
moments/
state.json
log.csv
ai_state.json
*.tmp

# pictures the tool makes again by itself
layouts/*.png
brand/preview*.png
brand/sample-frame.png
brand/_*

# backups and junk
*.bak
.DS_Store

# demo video: tools, recordings and output (rebuilt by demo/make_demo)
demo/.venv-voice/
demo/node_modules/
demo/work/
demo/out/
demo/music.*

# session handover notes: never commit
HANDOVER-*.md

# Taste Skill kit (installed per project, not committed)
.claude/
.taste-skill/

# site/ (the landing page): the safety copy of the full clip stays local; of Taste Skill's kit in site/assets only
# the files the page loads are committed (plus its MIT licence and the icon credits)
site/media/clip-full.mp4
